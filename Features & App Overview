    <footer class="w-full max-w-6xl mx-auto px-6 py-8 border-t border-zinc-900 flex flex-col sm:flex-row items-center justify-between text-xs text-zinc-500 relative z-10 mt-20">
        <p>&copy; 2026 Galahat Dev. All rights reserved.</p>
        
        <div class="flex items-center space-x-6 mt-4 sm:mt-0">
            <a id="gp-link" 
               href="https://play.google.com/store/apps/developer?id=Galahat+Dev" 
               target="_blank" 
               rel="noopener noreferrer" 
               class="hover:text-zinc-300 transition-all duration-500 whitespace-nowrap">
                Google Play Store
            </a>
            
            <div id="contact-wrapper" class="relative overflow-hidden h-5 w-16 transition-all duration-500 ease-out flex items-center justify-end">
                <button onclick="revealEmail()" id="contact-btn" class="hover:text-zinc-300 transition-all duration-300 text-right whitespace-nowrap cursor-pointer">
                    Contact
                </button>
                <a href="mailto:galahatdev@gmail.com" id="email-text" class="hover:text-teal-400 transition-all duration-500 absolute right-0 opacity-0 translate-y-3 pointer-events-none whitespace-nowrap">
                    galahatdev@gmail.com
                </a>
            </div>
        </div>
